  59:Core/Logic/logic_comm.c ****   if (Logic_Battery_Check_Critical())
  60:Core/Logic/logic_comm.c ****   {
  61:Core/Logic/logic_comm.c ****     Logic_Log("COMM: Battery critical\r\n");
  62:Core/Logic/logic_comm.c ****     return COMM_ERR_BATTERY_CRITICAL;
  63:Core/Logic/logic_comm.c ****   }
  64:Core/Logic/logic_comm.c **** 
  65:Core/Logic/logic_comm.c ****   if (health->lora_fail_count >= LORA_FAIL_MAX)
  66:Core/Logic/logic_comm.c ****   {
