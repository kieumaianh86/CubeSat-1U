  90:Core/Logic/logic_comm.c ****     Logic_Comm_Phase_Listen();
  91:Core/Logic/logic_comm.c ****     // Timeout or received GET_DATA
  92:Core/Logic/logic_comm.c ****     if (HAL_GetTick() - listen_tick > TIMEOUT_RX_LISTEN || dtx.requested) {
  93:Core/Logic/logic_comm.c ****       current_phase = dtx.requested ? COMM_PHASE_DATA_TX : COMM_PHASE_END;
  94:Core/Logic/logic_comm.c ****       Logic_Log("COMM: LISTEN done\r\n");
  95:Core/Logic/logic_comm.c ****     }
  96:Core/Logic/logic_comm.c ****     break;
  97:Core/Logic/logic_comm.c ****     
  98:Core/Logic/logic_comm.c ****   case COMM_PHASE_DATA_TX:
  99:Core/Logic/logic_comm.c ****     // NO TIMEOUT - continues until transmission complete or error
 100:Core/Logic/logic_comm.c ****     if (Logic_Comm_Phase_DataTx() == COMM_OK) {  
 101:Core/Logic/logic_comm.c ****       current_phase = COMM_PHASE_END;
 102:Core/Logic/logic_comm.c ****       Logic_Log("COMM: DATA_TX done\r\n");
 103:Core/Logic/logic_comm.c ****     }
 104:Core/Logic/logic_comm.c ****     break;
 105:Core/Logic/logic_comm.c ****     
 106:Core/Logic/logic_comm.c ****   case COMM_PHASE_END:
 107:Core/Logic/logic_comm.c ****     if (Logic_Comm_Phase_End() == COMM_OK) {
 108:Core/Logic/logic_comm.c ****       current_phase = COMM_PHASE_COMPLETE;
 109:Core/Logic/logic_comm.c ****     }
 110:Core/Logic/logic_comm.c ****     break;
 111:Core/Logic/logic_comm.c **** 
 112:Core/Logic/logic_comm.c ****   case COMM_PHASE_COMPLETE:
 113:Core/Logic/logic_comm.c ****     current_phase = COMM_PHASE_STANDBY;
 114:Core/Logic/logic_comm.c ****     return COMM_OK;
 115:Core/Logic/logic_comm.c ****   }
 116:Core/Logic/logic_comm.c ****   
 117:Core/Logic/logic_comm.c ****   return COMM_IN_PROGRESS;
 118:Core/Logic/logic_comm.c **** }
