  68:Core/Logic/logic_comm.c ****     reset();
  69:Core/Logic/logic_comm.c ****     return COMM_ERR_LORA_FAIL;
  70:Core/Logic/logic_comm.c ****   }
  71:Core/Logic/logic_comm.c **** 
  72:Core/Logic/logic_comm.c ****   switch (current_phase)
  73:Core/Logic/logic_comm.c ****   {
