 344:Core/Logic/logic_comm.c **** static comm_error_t Logic_Comm_Phase_DataTx(uint32_t ms)
 345:Core/Logic/logic_comm.c **** {
 346:Core/Logic/logic_comm.c ****   uint32_t now = HAL_GetTick();
 347:Core/Logic/logic_comm.c ****   if (ms < COMM_PHASE3_LISTEN_MS) return COMM_IN_PROGRESS;
 348:Core/Logic/logic_comm.c ****     
 349:Core/Logic/logic_comm.c ****     // Init
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccCyqzUL.s 			page 18


 350:Core/Logic/logic_comm.c ****     if (dtx.curr == 0 && !dtx.buf) {
