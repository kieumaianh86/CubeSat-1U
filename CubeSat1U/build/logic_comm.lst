 352:Core/Logic/logic_comm.c ****         dtx.buf = malloc(dtx.size);
 353:Core/Logic/logic_comm.c ****         if (!dtx.buf) return COMM_OK;
 354:Core/Logic/logic_comm.c ****         
 355:Core/Logic/logic_comm.c ****         // TODO: Flash_Read_Science_Data(dtx.buf, &dtx.size);
 356:Core/Logic/logic_comm.c ****         
