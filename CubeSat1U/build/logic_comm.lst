 247:Core/Logic/logic_comm.c **** static comm_error_t Logic_Comm_Phase_Listen(uint32_t ms)
 248:Core/Logic/logic_comm.c **** {
 249:Core/Logic/logic_comm.c ****     uint32_t now = HAL_GetTick();
 250:Core/Logic/logic_comm.c ****     
 251:Core/Logic/logic_comm.c ****     if (ms < COMM_PHASE2_SEND_BEACON_MS || (now - listen_tick) < LISTEN_POLL_INTERVAL_MS) {
 252:Core/Logic/logic_comm.c ****         return COMM_IN_PROGRESS;
 253:Core/Logic/logic_comm.c ****     }
 254:Core/Logic/logic_comm.c ****     
 255:Core/Logic/logic_comm.c ****     listen_tick = now;
 256:Core/Logic/logic_comm.c ****     
 257:Core/Logic/logic_comm.c ****     if (LoRa_E32_DataAvailable(&lora_handle)) {
 258:Core/Logic/logic_comm.c ****         uint8_t buf[256];
 259:Core/Logic/logic_comm.c ****         uint16_t len = sizeof(buf);
 260:Core/Logic/logic_comm.c ****         
 261:Core/Logic/logic_comm.c ****         if (LoRa_E32_Receive(&lora_handle, buf, &len, LISTEN_RX_TIMEOUT_MS) == LORA_E32_OK &&
 262:Core/Logic/logic_comm.c ****             len > 0 && buf[0] == PACKET_HEADER) {
 263:Core/Logic/logic_comm.c ****             
 264:Core/Logic/logic_comm.c ****             if (Packet_Verify_CRC(buf, len)) {
 265:Core/Logic/logic_comm.c ****                 Logic_Comm_Handle_Command(Packet_Parse_Type(buf), buf, len);
 266:Core/Logic/logic_comm.c ****             } else {
 267:Core/Logic/logic_comm.c ****                 uint8_t nack[8] = {PACKET_HEADER, PKT_TYPE_NACK};
 268:Core/Logic/logic_comm.c ****                 uint16_t crc = Packet_Calculate_CRC(nack, 2);
 269:Core/Logic/logic_comm.c ****                 nack[2] = crc >> 8;
 270:Core/Logic/logic_comm.c ****                 nack[3] = crc & 0xFF;
 271:Core/Logic/logic_comm.c ****                 LoRa_E32_Send(&lora_handle, nack, 4, 500);
 272:Core/Logic/logic_comm.c ****             }
 273:Core/Logic/logic_comm.c ****         }
 274:Core/Logic/logic_comm.c ****     }
 275:Core/Logic/logic_comm.c ****     
 276:Core/Logic/logic_comm.c ****     return COMM_IN_PROGRESS;
 277:Core/Logic/logic_comm.c **** }
