 279:Core/Logic/logic_comm.c **** static void Logic_Comm_Handle_Command(packet_type_t type, const uint8_t* pkt, uint16_t len)
 280:Core/Logic/logic_comm.c **** {
 281:Core/Logic/logic_comm.c ****   uint8_t resp[256];
 282:Core/Logic/logic_comm.c ****     uint16_t rlen = 0;
 283:Core/Logic/logic_comm.c ****     system_health_t* h = Logic_GetHealth();
 284:Core/Logic/logic_comm.c ****     cubesat_status_t* s = Logic_GetStatus();
 285:Core/Logic/logic_comm.c ****     
 286:Core/Logic/logic_comm.c ****     switch (type) {
 287:Core/Logic/logic_comm.c ****     case PKT_TYPE_PING:
 288:Core/Logic/logic_comm.c ****         rlen = Packet_Build_Pong(resp, ((ping_packet_t*)pkt)->timestamp);
 289:Core/Logic/logic_comm.c ****         break;
 290:Core/Logic/logic_comm.c ****         
 291:Core/Logic/logic_comm.c ****     case PKT_TYPE_GET_STATUS: {
 292:Core/Logic/logic_comm.c ****         status_packet_t st = {
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccCyqzUL.s 			page 17


 293:Core/Logic/logic_comm.c ****             .header = PACKET_HEADER, .type = PKT_TYPE_STATUS,
 294:Core/Logic/logic_comm.c ****             .current_state = (uint8_t)s->current_state,
 295:Core/Logic/logic_comm.c ****             .battery_percent = h->battery_percent,
 296:Core/Logic/logic_comm.c ****             .sensor_mpu6050 = h->sensor_status[SENSOR_MPU6050],
 297:Core/Logic/logic_comm.c ****             .sensor_hmc5883l = h->sensor_status[SENSOR_HMC5883L],
 298:Core/Logic/logic_comm.c ****             .sensor_tmp117 = h->sensor_status[SENSOR_DS18B20],
 299:Core/Logic/logic_comm.c ****             .sensor_ov2640 = h->sensor_status[SENSOR_CAMERA],
 300:Core/Logic/logic_comm.c ****             .sensor_gps = h->sensor_status[SENSOR_GPS],
 301:Core/Logic/logic_comm.c ****             .flash_free_kb = h->flash_free_kb,
 302:Core/Logic/logic_comm.c ****             .flash_used_kb = 4096 - h->flash_free_kb
 303:Core/Logic/logic_comm.c ****         };
 304:Core/Logic/logic_comm.c ****         rlen = Packet_Build_Status(resp, &st);
 305:Core/Logic/logic_comm.c ****         break;
 306:Core/Logic/logic_comm.c ****     }
 307:Core/Logic/logic_comm.c ****     
 308:Core/Logic/logic_comm.c ****     case PKT_TYPE_GET_DATA:
 309:Core/Logic/logic_comm.c ****         dtx.requested = true;
 310:Core/Logic/logic_comm.c ****         rlen = Packet_Build_ACK(resp, 0);
 311:Core/Logic/logic_comm.c ****         break;
 312:Core/Logic/logic_comm.c ****         
 313:Core/Logic/logic_comm.c ****     case PKT_TYPE_SET_CONFIG:
 314:Core/Logic/logic_comm.c ****         rlen = Packet_Build_ACK(resp, 0);
 315:Core/Logic/logic_comm.c ****         break;
 316:Core/Logic/logic_comm.c ****         
 317:Core/Logic/logic_comm.c ****     case PKT_TYPE_RESET:
 318:Core/Logic/logic_comm.c ****         rlen = Packet_Build_ACK(resp, 0);
 319:Core/Logic/logic_comm.c ****         LoRa_E32_Send(&lora_handle, resp, rlen, 500);
 320:Core/Logic/logic_comm.c ****         NVIC_SystemReset();
 321:Core/Logic/logic_comm.c ****         return;
 322:Core/Logic/logic_comm.c ****         
 323:Core/Logic/logic_comm.c ****     case PKT_TYPE_ENTER_SAFE:
 324:Core/Logic/logic_comm.c ****         Logic_Command_Set(CMD_ENTER_SAFE);
 325:Core/Logic/logic_comm.c ****         rlen = Packet_Build_ACK(resp, 0);
 326:Core/Logic/logic_comm.c ****         break;
 327:Core/Logic/logic_comm.c ****         
 328:Core/Logic/logic_comm.c ****     default: {
 329:Core/Logic/logic_comm.c ****         resp[0] = PACKET_HEADER;
 330:Core/Logic/logic_comm.c ****         resp[1] = PKT_TYPE_NACK;
 331:Core/Logic/logic_comm.c ****         uint16_t crc = Packet_Calculate_CRC(resp, 2);
 332:Core/Logic/logic_comm.c ****         resp[2] = crc >> 8;
 333:Core/Logic/logic_comm.c ****         resp[3] = crc & 0xFF;
 334:Core/Logic/logic_comm.c ****         rlen = 4;
 335:Core/Logic/logic_comm.c ****         break;
 336:Core/Logic/logic_comm.c ****     }
 337:Core/Logic/logic_comm.c ****     }
 338:Core/Logic/logic_comm.c ****     
 339:Core/Logic/logic_comm.c ****     if (rlen > 0) {
 340:Core/Logic/logic_comm.c ****         LoRa_E32_Send(&lora_handle, resp, rlen, 500);
 341:Core/Logic/logic_comm.c ****     }
 342:Core/Logic/logic_comm.c **** }
