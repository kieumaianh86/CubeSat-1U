 358:Core/Logic/logic_comm.c ****         dtx.last_tick = now;
 359:Core/Logic/logic_comm.c ****     }
 360:Core/Logic/logic_comm.c ****     
 361:Core/Logic/logic_comm.c ****     // TX loop
 362:Core/Logic/logic_comm.c ****     if (dtx.curr < dtx.total) {
 363:Core/Logic/logic_comm.c ****         if (dtx.wait_ack) {
 364:Core/Logic/logic_comm.c ****             uint8_t ack[32];
 365:Core/Logic/logic_comm.c ****             uint16_t alen = sizeof(ack), seq = 0;
 366:Core/Logic/logic_comm.c ****             
 367:Core/Logic/logic_comm.c ****             if (LoRa_E32_DataAvailable(&lora_handle) &&
 368:Core/Logic/logic_comm.c ****                 LoRa_E32_Receive(&lora_handle, ack, &alen, LISTEN_RX_TIMEOUT_MS) == LORA_E32_OK &&
 369:Core/Logic/logic_comm.c ****                 Packet_Parse_ACK(ack, alen, &seq) && seq == dtx.curr + 1) {
 370:Core/Logic/logic_comm.c ****                 
 371:Core/Logic/logic_comm.c ****                 dtx.fails = 0;
 372:Core/Logic/logic_comm.c ****                 dtx.curr++;
 373:Core/Logic/logic_comm.c ****                 dtx.wait_ack = false;
 374:Core/Logic/logic_comm.c ****             } else if ((now - dtx.last_tick) >= DATA_ACK_TIMEOUT_MS) {
 375:Core/Logic/logic_comm.c ****                 dtx.fails++;
 376:Core/Logic/logic_comm.c ****                 dtx.wait_ack = false;
 377:Core/Logic/logic_comm.c ****                 if (dtx.fails >= DATA_MAX_FAILS) return COMM_OK;
 378:Core/Logic/logic_comm.c ****             }
 379:Core/Logic/logic_comm.c ****         } else {
 380:Core/Logic/logic_comm.c ****             uint8_t tx[256], pay[DATA_PAYLOAD_MAX];
 381:Core/Logic/logic_comm.c ****             uint32_t rem = dtx.size - dtx.offset;
 382:Core/Logic/logic_comm.c ****             uint8_t plen = (rem > DATA_PAYLOAD_MAX) ? DATA_PAYLOAD_MAX : rem;
 383:Core/Logic/logic_comm.c ****             
 384:Core/Logic/logic_comm.c ****             if (dtx.curr == 0) {
 385:Core/Logic/logic_comm.c ****                 science_data_first_t* f = (science_data_first_t*)pay;
 386:Core/Logic/logic_comm.c ****                 memset(f, 0, sizeof(*f));
 387:Core/Logic/logic_comm.c ****                 f->has_image = 1;
 388:Core/Logic/logic_comm.c ****                 f->image_size = dtx.size;
 389:Core/Logic/logic_comm.c ****                 uint8_t hs = sizeof(*f);
 390:Core/Logic/logic_comm.c ****                 memcpy(&pay[hs], &dtx.buf[dtx.offset], plen - hs);
 391:Core/Logic/logic_comm.c ****                 dtx.offset += plen - hs;
 392:Core/Logic/logic_comm.c ****             } else {
 393:Core/Logic/logic_comm.c ****                 memcpy(pay, &dtx.buf[dtx.offset], plen);
 394:Core/Logic/logic_comm.c ****                 dtx.offset += plen;
 395:Core/Logic/logic_comm.c ****             }
 396:Core/Logic/logic_comm.c ****             
 397:Core/Logic/logic_comm.c ****             uint16_t tlen = Packet_Build_DataPacket(tx, dtx.curr + 1, dtx.total, pay, plen);
 398:Core/Logic/logic_comm.c ****             
 399:Core/Logic/logic_comm.c ****             if (LoRa_E32_Send(&lora_handle, tx, tlen, DATA_PACKET_TIMEOUT_MS) == LORA_E32_OK) {
 400:Core/Logic/logic_comm.c ****                 dtx.wait_ack = true;
 401:Core/Logic/logic_comm.c ****                 dtx.last_tick = now;
 402:Core/Logic/logic_comm.c ****             } else {
 403:Core/Logic/logic_comm.c ****                 dtx.fails++;
 404:Core/Logic/logic_comm.c ****                 if (dtx.fails >= DATA_MAX_FAILS) return COMM_OK;
 405:Core/Logic/logic_comm.c ****             }
 406:Core/Logic/logic_comm.c ****         }
