 286:Core/Logic/logic_comm.c **** // NO FIXED TIMEOUT - transmits until complete or max fails reached
 287:Core/Logic/logic_comm.c **** static comm_error_t Logic_Comm_Phase_DataTx(void) 
 288:Core/Logic/logic_comm.c **** {
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccwPfCrn.s 			page 78


 289:Core/Logic/logic_comm.c ****     // Initialize buffer on first call
 290:Core/Logic/logic_comm.c ****     if (dtx.curr == 0 && dtx.size == 0) {
 291:Core/Logic/logic_comm.c ****         dtx.buf = dtx_buffer;
 292:Core/Logic/logic_comm.c ****         
 293:Core/Logic/logic_comm.c ****         // Read data from SD card (could be sensor data or camera image)
 294:Core/Logic/logic_comm.c ****         dtx.size = sizeof(dtx_buffer);
 295:Core/Logic/logic_comm.c ****         if (SD_ReadScience(dtx.buf, &dtx.size) != SD_OK) {
 296:Core/Logic/logic_comm.c ****             Logic_Log("COMM: SD read failed\r\n");
 297:Core/Logic/logic_comm.c ****             dtx.size = 0;
 298:Core/Logic/logic_comm.c ****             return COMM_OK;  // Skip transmission
 299:Core/Logic/logic_comm.c ****         }
 300:Core/Logic/logic_comm.c ****         
 301:Core/Logic/logic_comm.c ****         dtx.total = (dtx.size + DATA_PAYLOAD_MAX - 1) / DATA_PAYLOAD_MAX;
 302:Core/Logic/logic_comm.c ****         dtx.last_tick = HAL_GetTick();
 303:Core/Logic/logic_comm.c ****         Logic_Log("COMM: Data ready, %lu bytes, %u packets\r\n", dtx.size, dtx.total);
 304:Core/Logic/logic_comm.c ****     }
 305:Core/Logic/logic_comm.c ****     
 306:Core/Logic/logic_comm.c ****     // Transmit packets sequentially with ACK
 307:Core/Logic/logic_comm.c ****     if (dtx.curr < dtx.total) {
 308:Core/Logic/logic_comm.c ****         if (dtx.wait_ack) {
 309:Core/Logic/logic_comm.c ****             // Wait for ACK
 310:Core/Logic/logic_comm.c ****             uint8_t ack[32];
 311:Core/Logic/logic_comm.c ****             uint16_t alen = sizeof(ack), seq;
 312:Core/Logic/logic_comm.c ****             
 313:Core/Logic/logic_comm.c ****             if (LoRa_E32_DataAvailable(&lora_handle) &&
 314:Core/Logic/logic_comm.c ****                 LoRa_E32_Receive(&lora_handle, ack, &alen, 100) == LORA_E32_OK &&
 315:Core/Logic/logic_comm.c ****                 Packet_Parse_ACK(ack, alen, &seq) && seq == dtx.curr + 1) {
 316:Core/Logic/logic_comm.c ****                 // ACK received
 317:Core/Logic/logic_comm.c ****                 dtx.fails = 0;
 318:Core/Logic/logic_comm.c ****                 dtx.curr++;
 319:Core/Logic/logic_comm.c ****                 dtx.wait_ack = false;
 320:Core/Logic/logic_comm.c ****                 Logic_Log("COMM: Packet %u/%u ACK\r\n", dtx.curr, dtx.total);
 321:Core/Logic/logic_comm.c ****             } else if (HAL_GetTick() - dtx.last_tick > TIMEOUT_ACK_TX) {
 322:Core/Logic/logic_comm.c ****                 // ACK timeout - retry
 323:Core/Logic/logic_comm.c ****                 dtx.fails++;
 324:Core/Logic/logic_comm.c ****                 dtx.wait_ack = false;
 325:Core/Logic/logic_comm.c ****                 Logic_Log("COMM: Packet %u timeout, retry\r\n", dtx.curr + 1);
 326:Core/Logic/logic_comm.c ****                 
 327:Core/Logic/logic_comm.c ****                 if (dtx.fails >= DATA_MAX_FAILS) {
 328:Core/Logic/logic_comm.c ****                     Logic_Log("COMM: Max fails reached\r\n");
 329:Core/Logic/logic_comm.c ****                     return COMM_OK;  // Complete with partial transmission
 330:Core/Logic/logic_comm.c ****                 }
 331:Core/Logic/logic_comm.c ****             }
 332:Core/Logic/logic_comm.c ****         } else {
 333:Core/Logic/logic_comm.c ****             // Send next packet
 334:Core/Logic/logic_comm.c ****             uint8_t tx[256], pay[DATA_PAYLOAD_MAX];
 335:Core/Logic/logic_comm.c ****             uint32_t rem = dtx.size - dtx.offset;
 336:Core/Logic/logic_comm.c ****             uint8_t plen = (rem > DATA_PAYLOAD_MAX) ? DATA_PAYLOAD_MAX : rem;
 337:Core/Logic/logic_comm.c ****             
 338:Core/Logic/logic_comm.c ****             memcpy(pay, &dtx.buf[dtx.offset], plen);
 339:Core/Logic/logic_comm.c ****             dtx.offset += plen;
 340:Core/Logic/logic_comm.c ****             
 341:Core/Logic/logic_comm.c ****             uint16_t tlen = Packet_Build_DataPacket(tx, dtx.curr + 1, dtx.total, pay, plen);
 342:Core/Logic/logic_comm.c ****             
 343:Core/Logic/logic_comm.c ****             if (LoRa_E32_Send(&lora_handle, tx, tlen, TIMEOUT_PACKET_TX) == LORA_E32_OK) {
 344:Core/Logic/logic_comm.c ****                 dtx.wait_ack = true;
 345:Core/Logic/logic_comm.c ****                 dtx.last_tick = HAL_GetTick();
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccwPfCrn.s 			page 79


 346:Core/Logic/logic_comm.c ****                 Logic_Log("COMM: Sent packet %u/%u (%u bytes)\r\n", dtx.curr + 1, dtx.total, plen);
 347:Core/Logic/logic_comm.c ****             } else {
 348:Core/Logic/logic_comm.c ****                 dtx.fails++;
 349:Core/Logic/logic_comm.c ****                 if (dtx.fails >= DATA_MAX_FAILS) {
 350:Core/Logic/logic_comm.c ****                     return COMM_OK;
 351:Core/Logic/logic_comm.c ****                 }
 352:Core/Logic/logic_comm.c ****             }
 353:Core/Logic/logic_comm.c ****         }
 354:Core/Logic/logic_comm.c ****         
 355:Core/Logic/logic_comm.c ****         return COMM_IN_PROGRESS;  // Continue transmission
 356:Core/Logic/logic_comm.c ****     } else {
 357:Core/Logic/logic_comm.c ****         // All packets sent successfully
 358:Core/Logic/logic_comm.c ****         uint8_t end[32];
 359:Core/Logic/logic_comm.c ****         uint16_t elen = Packet_Build_End(end, dtx.curr);
 360:Core/Logic/logic_comm.c ****         LoRa_E32_Send(&lora_handle, end, elen, 500);
 361:Core/Logic/logic_comm.c ****         Logic_Log("COMM: Transmission complete (%lu bytes)\r\n", dtx.size);
 362:Core/Logic/logic_comm.c ****         return COMM_OK;  // Done
 363:Core/Logic/logic_comm.c ****     }
 364:Core/Logic/logic_comm.c **** }
