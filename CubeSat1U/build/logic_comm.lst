 409:Core/Logic/logic_comm.c ****     // End
 410:Core/Logic/logic_comm.c ****     if (dtx.curr >= dtx.total || ms >= COMM_PHASE4_DATA_TX_MS) {
 411:Core/Logic/logic_comm.c ****         uint8_t end[32];
 412:Core/Logic/logic_comm.c ****         uint16_t elen = Packet_Build_End(end, dtx.curr);
