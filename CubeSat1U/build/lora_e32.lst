  48:Core/Lib/lora_e32.c **** lora_e32_status_t LoRa_E32_SetMode(lora_e32_handle_t* lora, lora_e32_mode_t mode)
  49:Core/Lib/lora_e32.c **** {
  50:Core/Lib/lora_e32.c ****     if (lora == NULL || !lora->initialized)
  51:Core/Lib/lora_e32.c ****     {
  52:Core/Lib/lora_e32.c ****         return LORA_E32_ERROR;
  53:Core/Lib/lora_e32.c ****     }
  54:Core/Lib/lora_e32.c ****     
  55:Core/Lib/lora_e32.c ****     switch (mode)
  56:Core/Lib/lora_e32.c ****     {
  57:Core/Lib/lora_e32.c ****     case LORA_E32_MODE_NORMAL:      // M0=0, M1=0
  58:Core/Lib/lora_e32.c ****         lora_set_mode_pins(lora, 0, 0);
  59:Core/Lib/lora_e32.c ****         break;
  60:Core/Lib/lora_e32.c ****     case LORA_E32_MODE_WAKEUP:      // M0=1, M1=0
  61:Core/Lib/lora_e32.c ****         lora_set_mode_pins(lora, 1, 0);
  62:Core/Lib/lora_e32.c ****         break;
  63:Core/Lib/lora_e32.c ****     case LORA_E32_MODE_POWER_SAVE:  // M0=0, M1=1
  64:Core/Lib/lora_e32.c ****         lora_set_mode_pins(lora, 0, 1);
  65:Core/Lib/lora_e32.c ****         break;
  66:Core/Lib/lora_e32.c ****     case LORA_E32_MODE_SLEEP:       // M0=1, M1=1
  67:Core/Lib/lora_e32.c ****         lora_set_mode_pins(lora, 1, 1);
  68:Core/Lib/lora_e32.c ****         break;
  69:Core/Lib/lora_e32.c ****     default:
  70:Core/Lib/lora_e32.c ****         return LORA_E32_INVALID_PARAM;
  71:Core/Lib/lora_e32.c ****     }
  72:Core/Lib/lora_e32.c ****     
  73:Core/Lib/lora_e32.c ****     if (!lora_wait_aux_high(lora, AUX_TIMEOUT_MS))
  74:Core/Lib/lora_e32.c ****     {
  75:Core/Lib/lora_e32.c ****         return LORA_E32_TIMEOUT;
  76:Core/Lib/lora_e32.c ****     }
  77:Core/Lib/lora_e32.c ****     
  78:Core/Lib/lora_e32.c ****     lora->current_mode = mode;
  79:Core/Lib/lora_e32.c ****     return LORA_E32_OK;
  80:Core/Lib/lora_e32.c **** }
