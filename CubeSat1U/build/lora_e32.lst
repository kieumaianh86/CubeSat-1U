 118:Core/Lib/lora_e32.c **** lora_e32_status_t LoRa_E32_Receive(lora_e32_handle_t* lora, uint8_t* data, uint16_t* len, uint32_t 
 119:Core/Lib/lora_e32.c **** {
 120:Core/Lib/lora_e32.c ****     if (lora == NULL || !lora->initialized || data == NULL || len == NULL)
 121:Core/Lib/lora_e32.c ****     {
 122:Core/Lib/lora_e32.c ****         return LORA_E32_INVALID_PARAM;
 123:Core/Lib/lora_e32.c ****     }
 124:Core/Lib/lora_e32.c ****     
 125:Core/Lib/lora_e32.c ****     uint32_t start = HAL_GetTick();
 126:Core/Lib/lora_e32.c ****     uint16_t count = 0;
 127:Core/Lib/lora_e32.c ****     uint16_t max_len = *len;
 128:Core/Lib/lora_e32.c ****     
 129:Core/Lib/lora_e32.c ****     // Read from circular buffer
 130:Core/Lib/lora_e32.c ****     while ((HAL_GetTick() - start) < timeout_ms && count < max_len)
 131:Core/Lib/lora_e32.c ****     {
 132:Core/Lib/lora_e32.c ****         if (lora->rx_read_index != lora->rx_write_index)
 133:Core/Lib/lora_e32.c ****         {
 134:Core/Lib/lora_e32.c ****             data[count++] = lora->rx_buffer[lora->rx_read_index];
 135:Core/Lib/lora_e32.c ****             lora->rx_read_index = (lora->rx_read_index + 1) % RX_BUFFER_SIZE;
 136:Core/Lib/lora_e32.c ****             start = HAL_GetTick(); // Reset timeout on data received
 137:Core/Lib/lora_e32.c ****         }
 138:Core/Lib/lora_e32.c ****     }
 139:Core/Lib/lora_e32.c ****     
 140:Core/Lib/lora_e32.c ****     *len = count;
 141:Core/Lib/lora_e32.c ****     
 142:Core/Lib/lora_e32.c ****     if (count == 0)
 143:Core/Lib/lora_e32.c ****     {
 144:Core/Lib/lora_e32.c ****         return LORA_E32_TIMEOUT;
 145:Core/Lib/lora_e32.c ****     }
ARM GAS  C:\Users\admin\AppData\Local\Temp\cc6mkeMe.s 			page 4


 146:Core/Lib/lora_e32.c ****     
 147:Core/Lib/lora_e32.c ****     return LORA_E32_OK;
 148:Core/Lib/lora_e32.c **** }
 149:Core/Lib/lora_e32.c **** 
 150:Core/Lib/lora_e32.c **** bool LoRa_E32_DataAvailable(const lora_e32_handle_t* lora)
 151:Core/Lib/lora_e32.c **** {
 152:Core/Lib/lora_e32.c ****     if (lora == NULL || !lora->initialized)
 153:Core/Lib/lora_e32.c ****     {
 154:Core/Lib/lora_e32.c ****         return false;
 155:Core/Lib/lora_e32.c ****     }
 156:Core/Lib/lora_e32.c ****     
 157:Core/Lib/lora_e32.c ****     // Check if there's data in circular buffer
 158:Core/Lib/lora_e32.c ****     return (lora->rx_read_index != lora->rx_write_index);
 159:Core/Lib/lora_e32.c **** }
 160:Core/Lib/lora_e32.c **** 
 161:Core/Lib/lora_e32.c **** void LoRa_E32_FlushRxBuffer(lora_e32_handle_t* lora)
 162:Core/Lib/lora_e32.c **** {
 163:Core/Lib/lora_e32.c ****     if (lora == NULL)
 164:Core/Lib/lora_e32.c ****     {
 165:Core/Lib/lora_e32.c ****         return;
 166:Core/Lib/lora_e32.c ****     }
 167:Core/Lib/lora_e32.c ****     
 168:Core/Lib/lora_e32.c ****     lora->rx_read_index = lora->rx_write_index;
 169:Core/Lib/lora_e32.c **** }
 170:Core/Lib/lora_e32.c **** 
 171:Core/Lib/lora_e32.c **** lora_e32_status_t LoRa_E32_PowerOff(lora_e32_handle_t* lora)
 172:Core/Lib/lora_e32.c **** {
 173:Core/Lib/lora_e32.c ****     if (lora == NULL)
 174:Core/Lib/lora_e32.c ****     {
 175:Core/Lib/lora_e32.c ****         return LORA_E32_INVALID_PARAM;
 176:Core/Lib/lora_e32.c ****     }
 177:Core/Lib/lora_e32.c ****     
 178:Core/Lib/lora_e32.c ****     // Set to sleep mode
 179:Core/Lib/lora_e32.c ****     return LoRa_E32_SetMode(lora, LORA_E32_MODE_SLEEP);
 180:Core/Lib/lora_e32.c **** }
 181:Core/Lib/lora_e32.c **** 
 182:Core/Lib/lora_e32.c **** lora_e32_status_t LoRa_E32_PowerOn(lora_e32_handle_t* lora)
 183:Core/Lib/lora_e32.c **** {
 184:Core/Lib/lora_e32.c ****     if (lora == NULL)
 185:Core/Lib/lora_e32.c ****     {
 186:Core/Lib/lora_e32.c ****         return LORA_E32_INVALID_PARAM;
 187:Core/Lib/lora_e32.c ****     }
 188:Core/Lib/lora_e32.c ****     
 189:Core/Lib/lora_e32.c ****     // Set to normal mode
 190:Core/Lib/lora_e32.c ****     return LoRa_E32_SetMode(lora, LORA_E32_MODE_NORMAL);
 191:Core/Lib/lora_e32.c **** }
 192:Core/Lib/lora_e32.c **** 
 193:Core/Lib/lora_e32.c **** void LoRa_E32_UART_IRQHandler(lora_e32_handle_t* lora)
 194:Core/Lib/lora_e32.c **** {
 195:Core/Lib/lora_e32.c ****     if (lora == NULL || !lora->initialized)
 196:Core/Lib/lora_e32.c ****     {
 197:Core/Lib/lora_e32.c ****         return;
 198:Core/Lib/lora_e32.c ****     }
 199:Core/Lib/lora_e32.c ****     
 200:Core/Lib/lora_e32.c ****     // Store received byte in circular buffer
 201:Core/Lib/lora_e32.c ****     uint16_t next_index = (lora->rx_write_index + 1) % RX_BUFFER_SIZE;
 202:Core/Lib/lora_e32.c ****     
ARM GAS  C:\Users\admin\AppData\Local\Temp\cc6mkeMe.s 			page 5


 203:Core/Lib/lora_e32.c ****     // Check for buffer overflow
 204:Core/Lib/lora_e32.c ****     if (next_index != lora->rx_read_index)
 205:Core/Lib/lora_e32.c ****     {
 206:Core/Lib/lora_e32.c ****         lora->rx_buffer[lora->rx_write_index] = lora->rx_temp;
 207:Core/Lib/lora_e32.c ****         lora->rx_write_index = next_index;
 208:Core/Lib/lora_e32.c ****     }
 209:Core/Lib/lora_e32.c ****     
 210:Core/Lib/lora_e32.c ****     // Continue receiving
 211:Core/Lib/lora_e32.c ****     HAL_UART_Receive_IT(lora->uart, &lora->rx_temp, 1);
