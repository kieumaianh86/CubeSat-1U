  92:Core/Lib/lora_e32.c **** lora_e32_status_t LoRa_E32_Send(lora_e32_handle_t* lora, const uint8_t* data, uint16_t len, uint32_
  93:Core/Lib/lora_e32.c **** {
  94:Core/Lib/lora_e32.c ****     if (lora == NULL || !lora->initialized || data == NULL || len == 0)
  95:Core/Lib/lora_e32.c ****     {
  96:Core/Lib/lora_e32.c ****         return LORA_E32_INVALID_PARAM;
  97:Core/Lib/lora_e32.c ****     }
  98:Core/Lib/lora_e32.c ****     
  99:Core/Lib/lora_e32.c ****     if (!LoRa_E32_IsReady(lora))
 100:Core/Lib/lora_e32.c ****     {
 101:Core/Lib/lora_e32.c ****         return LORA_E32_BUSY;
 102:Core/Lib/lora_e32.c ****     }
 103:Core/Lib/lora_e32.c ****     
 104:Core/Lib/lora_e32.c ****     if (HAL_UART_Transmit(lora->uart, (uint8_t*)data, len, timeout_ms) != HAL_OK)
 105:Core/Lib/lora_e32.c ****     {
 106:Core/Lib/lora_e32.c ****         return LORA_E32_ERROR;
 107:Core/Lib/lora_e32.c ****     }
 108:Core/Lib/lora_e32.c ****     
 109:Core/Lib/lora_e32.c ****     // Wait for transmission complete
 110:Core/Lib/lora_e32.c ****     if (!lora_wait_aux_high(lora, timeout_ms))
 111:Core/Lib/lora_e32.c ****     {
 112:Core/Lib/lora_e32.c ****         return LORA_E32_TIMEOUT;
 113:Core/Lib/lora_e32.c ****     }
 114:Core/Lib/lora_e32.c ****     
 115:Core/Lib/lora_e32.c ****     return LORA_E32_OK;
 116:Core/Lib/lora_e32.c **** }
