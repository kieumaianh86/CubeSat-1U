 128:FATFS/Target/sd_diskio.c **** static int SD_CheckStatusWithTimeout(uint32_t timeout)
 129:FATFS/Target/sd_diskio.c **** {
 130:FATFS/Target/sd_diskio.c ****   uint32_t timer;
 131:FATFS/Target/sd_diskio.c ****   /* block until SDIO peripheral is ready again or a timeout occur */
 132:FATFS/Target/sd_diskio.c **** #if (osCMSIS <= 0x20000U)
 133:FATFS/Target/sd_diskio.c ****   timer = osKernelSysTick();
 134:FATFS/Target/sd_diskio.c ****   while( osKernelSysTick() - timer < timeout)
 135:FATFS/Target/sd_diskio.c **** #else
 136:FATFS/Target/sd_diskio.c ****   timer = osKernelGetTickCount();
 137:FATFS/Target/sd_diskio.c ****   while( osKernelGetTickCount() - timer < timeout)
 138:FATFS/Target/sd_diskio.c **** #endif
 139:FATFS/Target/sd_diskio.c ****   {
 140:FATFS/Target/sd_diskio.c ****     if (BSP_SD_GetCardState() == SD_TRANSFER_OK)
 141:FATFS/Target/sd_diskio.c ****     {
 142:FATFS/Target/sd_diskio.c ****       return 0;
 143:FATFS/Target/sd_diskio.c ****     }
 144:FATFS/Target/sd_diskio.c ****   }
