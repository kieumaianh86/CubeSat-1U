  32:FATFS/Target/sd_diskio.c **** enable the defines below to send custom rtos messages
  33:FATFS/Target/sd_diskio.c **** when an error or an abort occurs.
  34:FATFS/Target/sd_diskio.c **** Notice: depending on the HAL/SD driver the HAL_SD_ErrorCallback()
  35:FATFS/Target/sd_diskio.c **** may not be available.
  36:FATFS/Target/sd_diskio.c **** See BSP_SD_ErrorCallback() and BSP_SD_AbortCallback() below
  37:FATFS/Target/sd_diskio.c **** ==================================================================
  38:FATFS/Target/sd_diskio.c **** 
  39:FATFS/Target/sd_diskio.c **** #define RW_ERROR_MSG       (uint32_t) 3
  40:FATFS/Target/sd_diskio.c **** #define RW_ABORT_MSG       (uint32_t) 4
  41:FATFS/Target/sd_diskio.c **** */
  42:FATFS/Target/sd_diskio.c **** /*
  43:FATFS/Target/sd_diskio.c ****  * the following Timeout is useful to give the control back to the applications
  44:FATFS/Target/sd_diskio.c ****  * in case of errors in either BSP_SD_ReadCpltCallback() or BSP_SD_WriteCpltCallback()
  45:FATFS/Target/sd_diskio.c ****  * the value by default is as defined in the BSP platform driver otherwise 30 secs
  46:FATFS/Target/sd_diskio.c ****  */
  47:FATFS/Target/sd_diskio.c **** #define SD_TIMEOUT 30 * 1000
  48:FATFS/Target/sd_diskio.c **** 
