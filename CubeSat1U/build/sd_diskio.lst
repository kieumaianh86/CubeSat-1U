  50:FATFS/Target/sd_diskio.c **** 
  51:FATFS/Target/sd_diskio.c **** /*
  52:FATFS/Target/sd_diskio.c ****  * Depending on the use case, the SD card initialization could be done at the
  53:FATFS/Target/sd_diskio.c ****  * application level: if it is the case define the flag below to disable
  54:FATFS/Target/sd_diskio.c ****  * the BSP_SD_Init() call in the SD_Initialize() and add a call to
  55:FATFS/Target/sd_diskio.c ****  * BSP_SD_Init() elsewhere in the application.
  56:FATFS/Target/sd_diskio.c ****  */
  57:FATFS/Target/sd_diskio.c **** /* USER CODE BEGIN disableSDInit */
  58:FATFS/Target/sd_diskio.c **** /* #define DISABLE_SD_INIT */
  59:FATFS/Target/sd_diskio.c **** /* USER CODE END disableSDInit */
  60:FATFS/Target/sd_diskio.c **** 
  61:FATFS/Target/sd_diskio.c **** /*
  62:FATFS/Target/sd_diskio.c ****  * when using cacheable memory region, it may be needed to maintain the cache
  63:FATFS/Target/sd_diskio.c ****  * validity. Enable the define below to activate a cache maintenance at each
  64:FATFS/Target/sd_diskio.c ****  * read and write operation.
  65:FATFS/Target/sd_diskio.c ****  * Notice: This is applicable only for cortex M7 based platform.
  66:FATFS/Target/sd_diskio.c ****  */
  67:FATFS/Target/sd_diskio.c **** /* USER CODE BEGIN enableSDDmaCacheMaintenance */
  68:FATFS/Target/sd_diskio.c **** /* #define ENABLE_SD_DMA_CACHE_MAINTENANCE  1 */
  69:FATFS/Target/sd_diskio.c **** /* USER CODE END enableSDDmaCacheMaintenance */
  70:FATFS/Target/sd_diskio.c **** 
  71:FATFS/Target/sd_diskio.c **** /*
  72:FATFS/Target/sd_diskio.c **** * Some DMA requires 4-Byte aligned address buffer to correctly read/write data,
  73:FATFS/Target/sd_diskio.c **** * in FatFs some accesses aren't thus we need a 4-byte aligned scratch buffer to correctly
  74:FATFS/Target/sd_diskio.c **** * transfer data
  75:FATFS/Target/sd_diskio.c **** */
  76:FATFS/Target/sd_diskio.c **** /* USER CODE BEGIN enableScratchBuffer */
  77:FATFS/Target/sd_diskio.c **** /* #define ENABLE_SCRATCH_BUFFER */
  78:FATFS/Target/sd_diskio.c **** /* USER CODE END enableScratchBuffer */
  79:FATFS/Target/sd_diskio.c **** 
  80:FATFS/Target/sd_diskio.c **** /* Private variables ---------------------------------------------------------*/
  81:FATFS/Target/sd_diskio.c **** #if defined(ENABLE_SCRATCH_BUFFER)
