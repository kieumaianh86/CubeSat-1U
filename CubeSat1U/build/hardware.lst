  98:Core/Hardware/hardware.c **** static int sensor_count = 0;
  99:Core/Hardware/hardware.c **** 
 100:Core/Hardware/hardware.c **** // Process hardware initialization
 101:Core/Hardware/hardware.c **** hw_status_t hardware_init_process(hardware_t *hw)
 102:Core/Hardware/hardware.c **** {
 103:Core/Hardware/hardware.c ****   if (hw == NULL)
 104:Core/Hardware/hardware.c ****   {
 105:Core/Hardware/hardware.c ****     return HW_ERROR;
 106:Core/Hardware/hardware.c ****   }
 107:Core/Hardware/hardware.c ****   
 108:Core/Hardware/hardware.c ****   // Check if mpu6050 needs wakeup processing
 109:Core/Hardware/hardware.c ****   if (!hw->mpu_ready && hw->mpu.init_state == MPU6050_INIT_STATE_WAKING_UP)
 110:Core/Hardware/hardware.c ****   {
 111:Core/Hardware/hardware.c ****     mpu6050_status_t status = mpu6050_init_process(&hw->mpu);
 112:Core/Hardware/hardware.c ****     if (status == MPU6050_OK)
 113:Core/Hardware/hardware.c ****     {
 114:Core/Hardware/hardware.c ****       hw->mpu_ready = 1;
 115:Core/Hardware/hardware.c ****     }
 116:Core/Hardware/hardware.c ****   }
 117:Core/Hardware/hardware.c **** 
 118:Core/Hardware/hardware.c ****   // Reset count before checking
 119:Core/Hardware/hardware.c ****   sensor_count = 0;
 120:Core/Hardware/hardware.c ****   
 121:Core/Hardware/hardware.c ****   // Check overall readiness
 122:Core/Hardware/hardware.c ****   if (hw->mag_ready)
 123:Core/Hardware/hardware.c ****   {
 124:Core/Hardware/hardware.c ****     sensor_count++;
 125:Core/Hardware/hardware.c ****   } 
 126:Core/Hardware/hardware.c ****   else 
 127:Core/Hardware/hardware.c ****   {
 128:Core/Hardware/hardware.c ****     Hardware_UART_Printf("Mag ERROR\r\n");
 129:Core/Hardware/hardware.c ****   }
 130:Core/Hardware/hardware.c ****   
 131:Core/Hardware/hardware.c ****   if (hw->mpu_ready)
 132:Core/Hardware/hardware.c ****   {
 133:Core/Hardware/hardware.c ****     sensor_count++;
 134:Core/Hardware/hardware.c ****   } 
 135:Core/Hardware/hardware.c ****   else
 136:Core/Hardware/hardware.c ****   {
 137:Core/Hardware/hardware.c ****     Hardware_UART_Printf("Mpu ERROR\r\n");
 138:Core/Hardware/hardware.c ****   }
 139:Core/Hardware/hardware.c ****   
 140:Core/Hardware/hardware.c ****   if (hw->gps_ready)
 141:Core/Hardware/hardware.c ****   {
 142:Core/Hardware/hardware.c ****     sensor_count++;
 143:Core/Hardware/hardware.c ****   }
 144:Core/Hardware/hardware.c ****   else 
 145:Core/Hardware/hardware.c ****   {
 146:Core/Hardware/hardware.c ****     Hardware_UART_Printf("GPS ERROR\r\n");
 147:Core/Hardware/hardware.c ****   }
 148:Core/Hardware/hardware.c ****   
 149:Core/Hardware/hardware.c ****   // Return based on sensor count
 150:Core/Hardware/hardware.c ****   if (sensor_count >= 3)
 151:Core/Hardware/hardware.c ****   {
 152:Core/Hardware/hardware.c ****     Hardware_UART_Printf("Sensors OK: %d\r\n", sensor_count);
 153:Core/Hardware/hardware.c ****     return HW_OK;
 154:Core/Hardware/hardware.c ****   }
ARM GAS  C:\Users\admin\AppData\Local\Temp\ccnx13RD.s 			page 8


 155:Core/Hardware/hardware.c ****   else
 156:Core/Hardware/hardware.c ****   {
 157:Core/Hardware/hardware.c ****     Hardware_UART_Printf("Sensors Fail: %d\r\n", sensor_count);
 158:Core/Hardware/hardware.c ****     return HW_IN_PROGRESS;
 159:Core/Hardware/hardware.c ****   }
 160:Core/Hardware/hardware.c **** }
