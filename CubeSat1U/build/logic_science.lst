 109:Core/Logic/logic_science.c **** static science_error_t Logic_Science_Phase_Prep(uint32_t ms)
 110:Core/Logic/logic_science.c **** {
 111:Core/Logic/logic_science.c ****   static bool sensors_powered = false;
 112:Core/Logic/logic_science.c ****   if (!sensors_powered && ms < SCIENCE_PHASE1_PREP_MS)
 113:Core/Logic/logic_science.c ****   {
 114:Core/Logic/logic_science.c ****     if (Logic_Battery_Check_Low())
 115:Core/Logic/logic_science.c ****     {
 116:Core/Logic/logic_science.c ****       Logic_Log("SCIENCE PREP: Battery low\r\n");
 117:Core/Logic/logic_science.c ****       return SCIENCE_ERR_BATTERY_LOW;
 118:Core/Logic/logic_science.c ****     }
 119:Core/Logic/logic_science.c **** 
 120:Core/Logic/logic_science.c ****     HW_Power_GPS_On();
 121:Core/Logic/logic_science.c ****     HW_Power_IMU_On();
 122:Core/Logic/logic_science.c ****     HW_Power_Magnetometer_On();
 123:Core/Logic/logic_science.c ****     HW_Power_Temperature_On();
 124:Core/Logic/logic_science.c ****     HW_Power_Camera_On();
 125:Core/Logic/logic_science.c **** 
 126:Core/Logic/logic_science.c ****     sensors_powered = true;
 127:Core/Logic/logic_science.c ****     Logic_Log("SCIENCE Prep: Sensors powered on\r\n");    
 128:Core/Logic/logic_science.c ****   }
 129:Core/Logic/logic_science.c **** 
 130:Core/Logic/logic_science.c ****   if (ms >= SCIENCE_PHASE1_PREP_MS)
 131:Core/Logic/logic_science.c ****   {
 132:Core/Logic/logic_science.c ****     sensors_powered = false;
 133:Core/Logic/logic_science.c ****     return SCIENCE_OK;
 134:Core/Logic/logic_science.c ****   }
 135:Core/Logic/logic_science.c ****   return SCIENCE_IN_PROGRESS;
 136:Core/Logic/logic_science.c **** }
