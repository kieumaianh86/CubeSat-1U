  59:Core/Logic/logic_science.c ****     return SCIENCE_ERR_EMERGENCY_CMD;
  60:Core/Logic/logic_science.c ****   }
  61:Core/Logic/logic_science.c ****   
  62:Core/Logic/logic_science.c ****   switch (current_phase)
  63:Core/Logic/logic_science.c ****   {
  64:Core/Logic/logic_science.c ****   case SCIENCE_PHASE_PREP:
  65:Core/Logic/logic_science.c ****     if (Logic_Science_Phase_Prep() == SCIENCE_OK) {
