  51:Core/Logic/logic_science.c ****       return SCIENCE_ERR_BATTERY_CRITICAL;
  52:Core/Logic/logic_science.c ****     }
  53:Core/Logic/logic_science.c ****   }
  54:Core/Logic/logic_science.c ****   
  55:Core/Logic/logic_science.c ****   // Emergency command check
  56:Core/Logic/logic_science.c ****   if (Logic_Command_Get_Pending() == CMD_START_COMM)
  57:Core/Logic/logic_science.c ****   {
