  32:Core/Lib/OV2640.c **** ov2640_status_t OV2640_Init(OV2640_Handle *cam,
  33:Core/Lib/OV2640.c ****                             I2C_HandleTypeDef *hi2c,
  34:Core/Lib/OV2640.c ****                             DCMI_HandleTypeDef *hdcmi)
  35:Core/Lib/OV2640.c **** {
  36:Core/Lib/OV2640.c ****     if (!cam || !hi2c || !hdcmi) return OV2640_INVALID_PARAM;
  37:Core/Lib/OV2640.c **** 
  38:Core/Lib/OV2640.c ****     memset(cam, 0, sizeof(*cam));
  39:Core/Lib/OV2640.c ****     cam->hi2c  = hi2c;
  40:Core/Lib/OV2640.c ****     cam->hdcmi = hdcmi;
  41:Core/Lib/OV2640.c **** 
  42:Core/Lib/OV2640.c ****     /* Mặc định (QVGA RGB565)  */
  43:Core/Lib/OV2640.c ****     cam->width  = 320;
  44:Core/Lib/OV2640.c ****     cam->height = 240;
  45:Core/Lib/OV2640.c ****     cam->bpp    = 2;
  46:Core/Lib/OV2640.c **** 
  47:Core/Lib/OV2640.c ****     /* Kiểm tra thiết bị trên bus */
  48:Core/Lib/OV2640.c ****     return OV2640_Ping(cam);
  49:Core/Lib/OV2640.c **** }
  50:Core/Lib/OV2640.c **** 
  51:Core/Lib/OV2640.c **** ov2640_status_t OV2640_Ping(OV2640_Handle *cam)
  52:Core/Lib/OV2640.c **** {
  53:Core/Lib/OV2640.c ****     if (!cam || !cam->hi2c) return OV2640_INVALID_PARAM;
  54:Core/Lib/OV2640.c **** 
  55:Core/Lib/OV2640.c ****     if (HAL_I2C_IsDeviceReady(cam->hi2c, (OV2640_I2C_ADDR_7BIT << 1),
  56:Core/Lib/OV2640.c ****                               2, OV2640_I2C_TIMEOUT_MS) == HAL_OK) {
  57:Core/Lib/OV2640.c ****         return OV2640_OK;
  58:Core/Lib/OV2640.c ****     }
  59:Core/Lib/OV2640.c ****     return OV2640_DEVICE_NOT_FOUND;
  60:Core/Lib/OV2640.c **** }
  61:Core/Lib/OV2640.c **** 
  62:Core/Lib/OV2640.c **** ov2640_status_t OV2640_Reset(OV2640_Handle *cam)
  63:Core/Lib/OV2640.c **** {
  64:Core/Lib/OV2640.c ****     if (!cam) return OV2640_INVALID_PARAM;
  65:Core/Lib/OV2640.c **** 
  66:Core/Lib/OV2640.c ****     /* Chọn bank 1, ghi reset mềm */
  67:Core/Lib/OV2640.c ****     if (_write_reg(cam, 0xFF, 0x01) != OV2640_OK) return OV2640_I2C_ERROR;
  68:Core/Lib/OV2640.c ****     if (_write_reg(cam, 0x12, 0x80) != OV2640_OK) return OV2640_I2C_ERROR;
  69:Core/Lib/OV2640.c **** 
  70:Core/Lib/OV2640.c ****     HAL_Delay(OV2640_RESET_DELAY_MS);
  71:Core/Lib/OV2640.c ****     return OV2640_OK;
  72:Core/Lib/OV2640.c **** }
  73:Core/Lib/OV2640.c **** 
  74:Core/Lib/OV2640.c **** ov2640_status_t OV2640_WriteReg(OV2640_Handle *cam, uint8_t reg, uint8_t val)
  75:Core/Lib/OV2640.c **** {
  76:Core/Lib/OV2640.c ****     return _write_reg(cam, reg, val);
  77:Core/Lib/OV2640.c **** }
  78:Core/Lib/OV2640.c **** 
  79:Core/Lib/OV2640.c **** ov2640_status_t OV2640_ReadReg(OV2640_Handle *cam, uint8_t reg, uint8_t *val)
  80:Core/Lib/OV2640.c **** {
  81:Core/Lib/OV2640.c ****     return _read_reg(cam, reg, val);
  82:Core/Lib/OV2640.c **** }
  83:Core/Lib/OV2640.c **** 
  84:Core/Lib/OV2640.c **** ov2640_status_t OV2640_ApplyTable(OV2640_Handle *cam, const ov2640_regval_t *tbl)
  85:Core/Lib/OV2640.c **** {
  86:Core/Lib/OV2640.c ****     return _apply_table(cam, tbl);
  87:Core/Lib/OV2640.c **** }
