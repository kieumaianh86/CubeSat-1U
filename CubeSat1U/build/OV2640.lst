  89:Core/Lib/OV2640.c **** ov2640_status_t OV2640_StartSnapshot(OV2640_Handle *cam, void *buf, uint32_t buf_len_bytes)
  90:Core/Lib/OV2640.c **** {
  91:Core/Lib/OV2640.c ****     if (!cam || !cam->hdcmi || !buf) return OV2640_INVALID_PARAM;
  92:Core/Lib/OV2640.c ****     if (cam->width == 0 || cam->height == 0 || cam->bpp == 0) return OV2640_INVALID_PARAM;
  93:Core/Lib/OV2640.c **** 
  94:Core/Lib/OV2640.c ****     uint32_t total_bytes = cam->width * cam->height * cam->bpp;
  95:Core/Lib/OV2640.c ****     if (buf_len_bytes < total_bytes) return OV2640_ERROR;
  96:Core/Lib/OV2640.c **** 
  97:Core/Lib/OV2640.c ****     /* DCMI DMA: length = số WORD 32-bit cần nhận */
  98:Core/Lib/OV2640.c ****     uint32_t len_words = (total_bytes + 3U) / 4U;
  99:Core/Lib/OV2640.c **** 
 100:Core/Lib/OV2640.c ****     cam->frame_ready = 0;
 101:Core/Lib/OV2640.c **** 
 102:Core/Lib/OV2640.c ****     /* Nếu cần, làm sạch cache trước khi nhận (tuỳ cấu hình hệ thống) */
 103:Core/Lib/OV2640.c **** #if (OV2640_DCACHE_MAINTENANCE)
 104:Core/Lib/OV2640.c ****   #if defined (SCB_CleanInvalidateDCache) || defined (SCB_CleanDCache)
 105:Core/Lib/OV2640.c ****     /* Với H7, nếu buffer ở DCache-able region và dùng DMA, cân nhắc Clean trước khi 
 106:Core/Lib/OV2640.c ****        Ở đây ta thường chỉ cần Invalidate SAU khi nhận xong. */
 107:Core/Lib/OV2640.c ****   #endif
 108:Core/Lib/OV2640.c **** #endif
 109:Core/Lib/OV2640.c **** 
 110:Core/Lib/OV2640.c ****     if (HAL_DCMI_Start_DMA(cam->hdcmi, DCMI_MODE_SNAPSHOT,
 111:Core/Lib/OV2640.c ****                            (uint32_t)buf, len_words) != HAL_OK) {
 112:Core/Lib/OV2640.c ****         return OV2640_ERROR;
 113:Core/Lib/OV2640.c ****     }
 114:Core/Lib/OV2640.c ****     return OV2640_OK;
 115:Core/Lib/OV2640.c **** }
 116:Core/Lib/OV2640.c **** 
 117:Core/Lib/OV2640.c **** ov2640_status_t OV2640_WaitFrame(OV2640_Handle *cam, uint32_t timeout_ms)
 118:Core/Lib/OV2640.c **** {
 119:Core/Lib/OV2640.c ****     if (!cam || !cam->hdcmi) return OV2640_INVALID_PARAM;
 120:Core/Lib/OV2640.c **** 
 121:Core/Lib/OV2640.c ****     uint32_t t0 = HAL_GetTick();
 122:Core/Lib/OV2640.c ****     while (!cam->frame_ready) {
 123:Core/Lib/OV2640.c ****         if (timeout_ms && (HAL_GetTick() - t0 >= timeout_ms)) {
 124:Core/Lib/OV2640.c ****             HAL_DCMI_Stop(cam->hdcmi);
 125:Core/Lib/OV2640.c ****             return OV2640_TIMEOUT;
 126:Core/Lib/OV2640.c ****         }
 127:Core/Lib/OV2640.c ****     }
 128:Core/Lib/OV2640.c **** 
 129:Core/Lib/OV2640.c ****     /* Dừng DCMI sau khi xong khung */
 130:Core/Lib/OV2640.c ****     HAL_DCMI_Stop(cam->hdcmi);
 131:Core/Lib/OV2640.c **** 
 132:Core/Lib/OV2640.c ****     /* Invalidate D-Cache để CPU thấy dữ liệu DMA mới */
 133:Core/Lib/OV2640.c **** #if (OV2640_DCACHE_MAINTENANCE)
 134:Core/Lib/OV2640.c ****   #if defined (SCB_InvalidateDCache_by_Addr)
 135:Core/Lib/OV2640.c ****     /* CHÚ Ý: địa chỉ phải 32-byte aligned khi gọi Invalidate theo vùng */
 136:Core/Lib/OV2640.c ****     /* Không có con trỏ buffer ở đây; người gọi biết địa chỉ buffer -> nên Inv
 137:Core/Lib/OV2640.c ****        nơi gọi OV2640_WaitFrame, khi có sẵn pointer buffer. */
 138:Core/Lib/OV2640.c ****   #endif
 139:Core/Lib/OV2640.c **** #endif
 140:Core/Lib/OV2640.c **** 
 141:Core/Lib/OV2640.c ****     return OV2640_OK;
 142:Core/Lib/OV2640.c **** }
