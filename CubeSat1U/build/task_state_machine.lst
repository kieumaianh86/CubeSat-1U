 122:Core/RTOS/task_state_machine.c **** static void CheckCriticalCondition(void)
 123:Core/RTOS/task_state_machine.c **** {
 124:Core/RTOS/task_state_machine.c ****   //battery critical -> force SAFE
 125:Core/RTOS/task_state_machine.c ****   if (g_shared.health.battery_percent < BATTERY_CRITICAL)
 126:Core/RTOS/task_state_machine.c ****   {
 127:Core/RTOS/task_state_machine.c ****     if (g_shared.status.current_state != STATE_SAFE &&
 128:Core/RTOS/task_state_machine.c ****        g_shared.status.current_state != STATE_SLEEP)
 129:Core/RTOS/task_state_machine.c ****     {
 130:Core/RTOS/task_state_machine.c ****       g_shared.status.error_code = 0x01;
 131:Core/RTOS/task_state_machine.c ****       TransitionTo(STATE_SAFE);
 132:Core/RTOS/task_state_machine.c ****     }
 133:Core/RTOS/task_state_machine.c ****     
 134:Core/RTOS/task_state_machine.c ****   }
 135:Core/RTOS/task_state_machine.c ****   //sensor critical fail -> SAFE
 136:Core/RTOS/task_state_machine.c ****   if (g_shared.health.working_sensor_count < (SENSOR_TOTAL - SENSOR_CRITICAL_FAIL + 1))
 137:Core/RTOS/task_state_machine.c ****   {
 138:Core/RTOS/task_state_machine.c ****     if (g_shared.status.current_state != STATE_SAFE)
 139:Core/RTOS/task_state_machine.c ****     {
 140:Core/RTOS/task_state_machine.c ****       g_shared.status.error_code = 0x02; //sensor critical
 141:Core/RTOS/task_state_machine.c ****       TransitionTo(STATE_SAFE);
 142:Core/RTOS/task_state_machine.c ****     }
 143:Core/RTOS/task_state_machine.c ****     
 144:Core/RTOS/task_state_machine.c ****   }
 145:Core/RTOS/task_state_machine.c ****   // Temperature out of range -> SAFE
